# Test harness base settings
#
# Checked-in, non-sensitive defaults for ./run-harness.sh. Docker Compose uses
# these values to fill in the ${VARIABLE} references in docker-compose.yml.
#
# Do not put secrets in this file. A setting that needs a secret is listed here
# with an empty value. Set it in .env, which is never checked in.
#
# The settings files are read in this order. A later file overrides an earlier
# one, so change a setting locally by adding it to .env, not by editing this file:
#   1. base.env     this file
#   2. .env         optional - local overrides and secrets
#   3. secrets.env  optional - legacy, use .env instead
# A variable exported in the shell that runs run-harness.sh overrides all three.

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# These defaults point at the mock OIDC server (the `oidc` container), which the
# harness starts unless it is run with auth=Entra. To use Entra, override all six
# settings in .env. See "Using Entra authentication" in README.md.

# OIDC client that forms-designer signs users in with. forms-entitlement-api uses
# the same client to call Microsoft Graph when SYNC_ADMIN_USERS_ENABLED=true.
AZURE_CLIENT_ID=local-test-client
AZURE_CLIENT_SECRET=local-mock-secret

# OIDC discovery document that forms-designer reads to find the sign-in endpoints
OIDC_WELL_KNOWN_CONFIGURATION_URL=http://localhost:5556/.well-known/openid-configuration

# How the back-end services (forms-manager, forms-submission-api,
# forms-entitlement-api, forms-audit-api, forms-notify-listener and
# forms-sharepoint-listener) validate the access token sent by forms-designer:
# where to fetch the signing keys, and the audience and issuer the token must have
OIDC_JWKS_URI=http://host.docker.internal:5556/.well-known/openid-configuration/jwks
OIDC_VERIFY_AUD=local-test-client
OIDC_VERIFY_ISS=http://oidc:80

# ------------------------------------------------------------------------------
# User entitlements (forms-entitlement-api)
# ------------------------------------------------------------------------------
# Entra tenant that forms-entitlement-api queries through Microsoft Graph
AZURE_TENANT_ID=6f504113-6b64-43f2-ade9-242e05780007

# Members of this group are treated as form editors. The mock OIDC users in
# ../local-development-dependencies/oidc-config/users.yml belong to this group.
ROLE_EDITOR_GROUP_ID=5b8a0214-74d3-4bf0-b665-102511c967b2

# ------------------------------------------------------------------------------
# Redis (session cache for forms-designer, forms-runner and forms-identity-ui)
# ------------------------------------------------------------------------------
# Credentials the services use to connect to the local Redis container
REDIS_USERNAME=default
REDIS_PASSWORD=my-password

# ------------------------------------------------------------------------------
# forms-runner
# ------------------------------------------------------------------------------
# Key used to encrypt the session cookie. Local test value only.
RUNNER_SESSION_COOKIE_PASSWORD=53409gjhfcdiklgjidfglkgjdflkelrku634

# SENSITIVE - set in .env. Ordnance Survey API credentials, used for the map and
# location features. When left empty, docker-compose.yml substitutes a
# placeholder, so the harness starts but those features do not work.
ORDNANCE_SURVEY_API_KEY=
ORDNANCE_SURVEY_API_SECRET=

# ------------------------------------------------------------------------------
# GOV.UK Notify (email)
# ------------------------------------------------------------------------------
# SENSITIVE - set in .env. API key used by forms-manager, forms-runner,
# forms-submission-api, forms-notify-listener and forms-identity-api to send
# email. When left empty, the harness starts but no email can be sent.
NOTIFY_API_KEY=

# Notify template and reply-to address that forms-submission-api sends email with
NOTIFY_TEMPLATE_ID=3d448938-8a8b-40c2-a3de-414597f976e1
NOTIFY_REPLY_TO_ID=c0428382-7df0-4e57-89fa-20bb69e9e755

# ------------------------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------------------------
# forms-manager publishes audit events when this is true
FEATURE_FLAG_PUBLISH_AUDIT_EVENTS=true
